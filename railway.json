{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "railway.json",
      "Procfile",
      "requirements.txt",
      "app.py",
      "railway_app.py",
      "payment_hold.py",
      "paypal_checkout.py",
      "booking_notifications.py",
      "addons.py",
      "v6_features.py",
      "stability.py",
      "zab_os.py",
      "host_assistant.py",
      "smart_host.py",
      "knowledge.py",
      "quality_v12.py",
      "alltag.py",
      "templates/**",
      "static/**"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120 railway_app:app",
    "healthcheckPath": "/health/live",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
