{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": [
      "**/*.py",
      "railway.json",
      "Procfile",
      "requirements.txt",
      "pricing-2027.json",
      "templates/**",
      "static/**"
    ]
  },
  "deploy": {
    "startCommand": "gunicorn --bind 0.0.0.0:$PORT --workers 1 --threads 4 --timeout 120 rank_price_wachau_entrypoint:app",
    "healthcheckPath": "/health/wachauetappe_production",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
