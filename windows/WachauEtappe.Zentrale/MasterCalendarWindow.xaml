<Window x:Class="WachauEtappe.Zentrale.MasterCalendarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zuhause am Bach OS · Master-Kalender" Height="940" Width="1500"
        MinHeight="760" MinWidth="1180" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="4,0"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="6,4"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="5,3"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Margin" Value="3"/></Style>
  </Window.Resources>
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="3*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="2*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="14" Margin="0,0,0,12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Left">
          <TextBlock Text="Zuhause am Bach OS" FontSize="25" FontWeight="Bold" Foreground="#173D32"/>
          <TextBlock Text="Master-Kalender · Verfügbarkeit · Preise · Gäste · Kanäle" Foreground="#65756F"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
          <TextBlock x:Name="ConnectivityText" Text="Booking.com: wird geprüft …" FontWeight="SemiBold" HorizontalAlignment="Right"/>
          <TextBlock x:Name="PayPalModeText" Text="PayPal-Masterstatus: wird geprüft …" Foreground="#65756F" HorizontalAlignment="Right"/>
        </StackPanel>
        <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <Button Content="← Monat" Click="PreviousMonth_Click"/>
          <TextBlock x:Name="MonthText" Text="Monat" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0"/>
          <Button Content="Monat →" Click="NextMonth_Click"/>
          <ComboBox x:Name="RoomBox" Width="220" Margin="20,0,4,0" SelectionChanged="RoomBox_SelectionChanged"/>
          <Button Content="Aktualisieren" Click="Refresh_Click"/>
        </WrapPanel>
      </DockPanel>
    </Border>

    <DataGrid Grid.Row="1" x:Name="CalendarGrid" AutoGenerateColumns="False" IsReadOnly="True"
              SelectionMode="Single" SelectionChanged="CalendarGrid_SelectionChanged"
              CanUserAddRows="False" HeadersVisibility="Column" Background="White" RowHeaderWidth="0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Datum" Binding="{Binding DateLabel}" Width="95"/>
        <DataGridTextColumn Header="Belegung" Binding="{Binding OccupancyLabel}" Width="135"/>
        <DataGridTextColumn Header="Gast" Binding="{Binding GuestName}" Width="170"/>
        <DataGridTextColumn Header="Land" Binding="{Binding Country}" Width="105"/>
        <DataGridTextColumn Header="Pers." Binding="{Binding GuestsLabel}" Width="55"/>
        <DataGridTextColumn Header="Frühstück" Binding="{Binding BreakfastLabel}" Width="80"/>
        <DataGridTextColumn Header="Anreise" Binding="{Binding TransportLabel}" Width="105"/>
        <DataGridTextColumn Header="Direkt" Binding="{Binding DirectLabel}" Width="115"/>
        <DataGridTextColumn Header="Booking.com" Binding="{Binding BookingLabel}" Width="125"/>
        <DataGridTextColumn Header="Booking-Sync" Binding="{Binding BookingSyncLabel}" Width="165"/>
        <DataGridTextColumn Header="Airbnb" Binding="{Binding AirbnbLabel}" Width="115"/>
        <DataGridTextColumn Header="Weitere" Binding="{Binding OtherLabel}" Width="115"/>
      </DataGrid.Columns>
    </DataGrid>

    <TextBlock Grid.Row="2" x:Name="StatusText" Margin="2,10" Foreground="#397356" FontWeight="SemiBold" TextWrapping="Wrap"/>

    <TabControl Grid.Row="3" Margin="0,0,0,0">
      <TabItem Header="Tag / Zeitraum steuern">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <WrapPanel>
              <TextBlock Text="Von" VerticalAlignment="Center"/><DatePicker x:Name="FromDate" Width="145"/>
              <TextBlock Text="Bis" VerticalAlignment="Center" Margin="8,0,0,0"/><DatePicker x:Name="ToDate" Width="145"/>
              <CheckBox x:Name="SyncBookingPriceBox" Content="Booking-Preis sofort synchronisieren" IsChecked="True" VerticalAlignment="Center" Margin="18,0,0,0"/>
            </WrapPanel>
            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <GroupBox Grid.Column="0" Header="Direkt" Margin="4"><StackPanel Margin="8">
                <ComboBox x:Name="DirectStatusBox" SelectedIndex="0"><ComboBoxItem Content="Nicht ändern" Tag="keep"/><ComboBoxItem Content="Offen" Tag="open"/><ComboBoxItem Content="Geschlossen" Tag="closed"/><ComboBoxItem Content="Standard" Tag="reset"/></ComboBox>
                <TextBox x:Name="DirectPriceBox" ToolTip="Preis pro Nacht in EUR"/>
              </StackPanel></GroupBox>
              <GroupBox Grid.Column="1" Header="Booking.com" Margin="4"><StackPanel Margin="8">
                <ComboBox x:Name="BookingStatusBox" SelectedIndex="0"><ComboBoxItem Content="Nicht ändern" Tag="keep"/><ComboBoxItem Content="Offen" Tag="open"/><ComboBoxItem Content="Geschlossen" Tag="closed"/><ComboBoxItem Content="Standard" Tag="reset"/></ComboBox>
                <TextBox x:Name="BookingPriceBox" ToolTip="Booking.com Preis pro Nacht in EUR"/>
              </StackPanel></GroupBox>
              <GroupBox Grid.Column="2" Header="Airbnb" Margin="4"><StackPanel Margin="8">
                <ComboBox x:Name="AirbnbStatusBox" SelectedIndex="0"><ComboBoxItem Content="Nicht ändern" Tag="keep"/><ComboBoxItem Content="Offen" Tag="open"/><ComboBoxItem Content="Geschlossen" Tag="closed"/><ComboBoxItem Content="Standard" Tag="reset"/></ComboBox>
                <TextBox x:Name="AirbnbPriceBox" ToolTip="Airbnb Zielpreis pro Nacht in EUR"/>
              </StackPanel></GroupBox>
              <GroupBox Grid.Column="3" Header="Weitere Kanäle" Margin="4"><StackPanel Margin="8">
                <ComboBox x:Name="OtherStatusBox" SelectedIndex="0"><ComboBoxItem Content="Nicht ändern" Tag="keep"/><ComboBoxItem Content="Offen" Tag="open"/><ComboBoxItem Content="Geschlossen" Tag="closed"/><ComboBoxItem Content="Standard" Tag="reset"/></ComboBox>
                <TextBox x:Name="OtherPriceBox" ToolTip="Zielpreis pro Nacht in EUR"/>
              </StackPanel></GroupBox>
            </Grid>
            <WrapPanel Margin="0,10,0,0">
              <Button Content="Zeitraum speichern" Click="SaveDaySettings_Click" Background="#173D32" Foreground="White"/>
              <Button Content="Booking-Preise dieses Zeitraums erneut senden" Click="RetryBookingPrices_Click"/>
            </WrapPanel>
            <TextBlock Margin="4,10,4,0" Foreground="#65756F" TextWrapping="Wrap"
                       Text="Booking.com: Der Preis wird nicht über iCal übertragen. Wenn Booking Connectivity samt Zimmer-/Ratenplan-Mapping eingerichtet ist, sendet das OS den Preis direkt an Booking.com und zeigt den Bestätigungsstatus im Kalender. Airbnb/Weitere bleiben bis zur jeweiligen API-Anbindung OS-Zielpreise."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Gast / Aufenthalt">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="14">
            <WrapPanel>
              <TextBlock x:Name="GuestSelectionText" Text="Bitte einen belegten Kalendertag auswählen." FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Button Content="Booking-Gäste jetzt synchronisieren" Click="SyncBookingGuests_Click" Margin="18,0,0,0"/>
            </WrapPanel>
            <UniformGrid Columns="4" Margin="0,10,0,0">
              <StackPanel Margin="4"><TextBlock Text="Gastname"/><TextBox x:Name="GuestNameBox"/></StackPanel>
              <StackPanel Margin="4"><TextBlock Text="Land / Herkunft"/><TextBox x:Name="CountryBox"/></StackPanel>
              <StackPanel Margin="4"><TextBlock Text="Personen"/><TextBox x:Name="GuestsBox"/></StackPanel>
              <StackPanel Margin="4"><TextBlock Text="Booking-Referenz"/><TextBox x:Name="BookingReferenceBox"/></StackPanel>
            </UniformGrid>
            <WrapPanel Margin="4,10,0,0">
              <CheckBox x:Name="BreakfastBox" Content="Frühstück" IsThreeState="True" VerticalAlignment="Center" Margin="0,0,24,0"/>
              <TextBlock Text="Anreiseart" VerticalAlignment="Center"/>
              <ComboBox x:Name="TransportBox" Width="180">
                <ComboBoxItem Content="Nicht angegeben" Tag=""/>
                <ComboBoxItem Content="🚗 Auto" Tag="auto"/>
                <ComboBoxItem Content="🚲 Fahrrad" Tag="bike"/>
                <ComboBoxItem Content="🥾 Wanderer" Tag="hiker"/>
                <ComboBoxItem Content="Sonstiges" Tag="other"/>
              </ComboBox>
            </WrapPanel>
            <TextBlock Text="Interne Notiz" Margin="4,10,0,0"/><TextBox x:Name="GuestNotesBox" Height="60" AcceptsReturn="True" TextWrapping="Wrap"/>
            <Button Content="Gastdaten im OS speichern" Click="SaveGuest_Click" HorizontalAlignment="Left" Margin="4,10,0,0" Background="#173D32" Foreground="White"/>
            <TextBlock Margin="4,10,4,0" Foreground="#65756F" TextWrapping="Wrap"
                       Text="Diese Angaben sind intern. Booking.com kann bei Connectivity das vom Booker angegebene Wohnsitzland liefern; das ist keine amtlich geprüfte Staatsangehörigkeit. Öffentliche iCal-Feeds enthalten weder Namen noch Land/Herkunft, Personenanzahl, Frühstück noch Anreiseart."/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Airbnb / weitere Kalender">
        <StackPanel Margin="14">
          <TextBlock Text="Externe iCal-Kalender in den OS-Master einlesen" FontWeight="Bold" FontSize="17"/>
          <WrapPanel Margin="0,12,0,0">
            <ComboBox x:Name="ImportChannelBox" Width="160" SelectedIndex="0" SelectionChanged="ImportChannelBox_SelectionChanged"><ComboBoxItem Content="Airbnb" Tag="airbnb"/><ComboBoxItem Content="Weiterer Kanal" Tag="other"/></ComboBox>
            <TextBox x:Name="ImportUrlBox" Width="650" ToolTip="https://... .ics"/>
            <Button Content="URL speichern" Click="SaveImport_Click"/>
            <Button Content="Jetzt synchronisieren" Click="SyncImport_Click"/>
          </WrapPanel>
          <TextBlock x:Name="ImportStatusText" Margin="4,10" Foreground="#397356" TextWrapping="Wrap"/>
          <TextBlock Foreground="#65756F" TextWrapping="Wrap"
                     Text="Airbnb/weitere iCal-Feeds liefern Belegung, aber normalerweise keine verlässlichen Preise oder vollständigen Gastdaten. Diese Daten können im Gast-Tab intern ergänzt werden."/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
