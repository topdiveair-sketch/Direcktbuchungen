<Window x:Class="WachauEtappe.Zentrale.SystemWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · System" Height="620" Width="920" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="System &amp; Datensicherung" FontSize="28" FontWeight="Bold" Foreground="#173D32"/><TextBlock Text="Lokale Datenbank sichern, wiederherstellen und Betriebsdaten exportieren." Foreground="#64736D" Margin="0,4,0,18"/></StackPanel>
<StackPanel Grid.Row="1">
<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="Datenbank" FontSize="19" FontWeight="SemiBold" Foreground="#173D32"/><TextBlock x:Name="DbPathText" Margin="0,5,0,14" Foreground="#64736D" TextWrapping="Wrap"/><WrapPanel><Button Content="Backup erstellen" Click="Backup_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Backup wiederherstellen" Click="Restore_Click" Padding="14,8"/></WrapPanel></StackPanel></Border>
<Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Text="CSV-Export" FontSize="19" FontWeight="SemiBold" Foreground="#173D32"/><TextBlock Text="Buchungen, Gastgeber oder Reisen als CSV exportieren." Foreground="#64736D" Margin="0,5,0,14"/><WrapPanel><Button Content="Buchungen exportieren" Click="ExportBookings_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Gastgeber exportieren" Click="ExportHosts_Click" Padding="14,8" Margin="0,0,8,0"/><Button Content="Reisen exportieren" Click="ExportTrips_Click" Padding="14,8"/></WrapPanel></StackPanel></Border>
<TextBlock x:Name="StatusText" Foreground="#397356" TextWrapping="Wrap"/>
</StackPanel></Grid></Window>