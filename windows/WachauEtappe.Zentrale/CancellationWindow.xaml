<Window x:Class="WachauEtappe.Zentrale.CancellationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Stornozentrale" Height="720" Width="1120" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Stornozentrale" FontSize="28" FontWeight="Bold" Foreground="#173D32"/><TextBlock Text="Stornos prüfen, Status setzen und Wiederverkauf dokumentieren. Keine automatische Abbuchung." Foreground="#64736D" Margin="0,4,0,16"/></StackPanel>
<DataGrid Grid.Row="1" x:Name="CancellationGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" Margin="0,0,0,14"/>
<WrapPanel Grid.Row="2"><Button Content="Als geprüft markieren" Click="Approve_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Abgelehnt" Click="Reject_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Zimmer weiterverkauft" Click="Resold_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Aktualisieren" Click="Refresh_Click" Padding="12,7"/></WrapPanel>
</Grid></Window>