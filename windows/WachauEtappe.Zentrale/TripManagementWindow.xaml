<Window x:Class="WachauEtappe.Zentrale.TripManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Reisen" Height="760" Width="1250" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="12" Padding="16" Margin="0,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Top"><DockPanel><TextBlock Text="Reisen" FontSize="25" FontWeight="Bold" Foreground="#173D32"/><Button Content="+ Neue Reise" Click="NewTrip_Click" HorizontalAlignment="Right" Padding="12,6"/></DockPanel><TextBlock Text="Komplette Touren zentral verwalten" Foreground="#718079" Margin="0,3,0,12"/></StackPanel><ListBox x:Name="TripList" SelectionChanged="TripList_SelectionChanged" DisplayMemberPath="Reference"/></DockPanel></Border>
<Border Grid.Column="1" Background="White" CornerRadius="12" Padding="22"><ScrollViewer><StackPanel><TextBlock x:Name="ReferenceText" Text="Reise auswählen" FontSize="24" FontWeight="Bold" Foreground="#173D32"/><Grid Margin="0,18,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Gast"/><TextBox x:Name="GuestBox"/><TextBlock Text="E-Mail" Margin="0,8,0,0"/><TextBox x:Name="EmailBox"/><TextBlock Text="Telefon" Margin="0,8,0,0"/><TextBox x:Name="PhoneBox"/></StackPanel><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="Erster Reisetag"/><DatePicker x:Name="StartDatePicker"/><TextBlock Text="Tagesleistung km" Margin="0,8,0,0"/><TextBox x:Name="DailyKmBox" Text="18"/><TextBlock Text="Personen" Margin="0,8,0,0"/><TextBox x:Name="GuestsBox" Text="1"/><CheckBox x:Name="LuggageCheck" Content="Gepäcktransport für Reise" Margin="0,12,0,0"/></StackPanel></Grid><Button Content="Reise speichern" Click="SaveTrip_Click" Padding="14,8" HorizontalAlignment="Left" Margin="0,8,0,18"/>
<TextBlock Text="Etappen &amp; Übernachtungen" FontSize="19" FontWeight="SemiBold" Foreground="#173D32"/><DataGrid x:Name="DaysGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="245" Margin="0,10,0,10"><DataGrid.Columns><DataGridTextColumn Header="Tag" Binding="{Binding DayNumber}" Width="45"/><DataGridTextColumn Header="Datum" Binding="{Binding TravelDate}" Width="90"/><DataGridTextColumn Header="Von" Binding="{Binding FromPlace}" Width="*"/><DataGridTextColumn Header="Nach" Binding="{Binding ToPlace}" Width="*"/><DataGridTextColumn Header="km" Binding="{Binding DistanceKm}" Width="60"/><DataGridTextColumn Header="Gastgeber" Binding="{Binding HostName}" Width="160"/><DataGridTextColumn Header="Buchung" Binding="{Binding BookingStatus}" Width="90"/><DataGridTextColumn Header="Gepäck" Binding="{Binding LuggageStatus}" Width="90"/></DataGrid.Columns></DataGrid>
<WrapPanel><Button Content="Etappe hinzufügen" Click="AddDay_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Etappe bestätigt" Click="ConfirmDay_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Gepäck bestätigt" Click="ConfirmLuggage_Click" Padding="12,7" Margin="0,0,8,0"/><Button Content="Storno erfassen" Click="Cancel_Click" Padding="12,7"/></WrapPanel><TextBlock x:Name="StatusText" Foreground="#397356" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
</Grid></Window>