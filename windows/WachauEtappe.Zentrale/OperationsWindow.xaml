<Window x:Class="WachauEtappe.Zentrale.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Betrieb" Height="760" Width="1180" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><TabControl>
<TabItem Header="Verfügbarkeit"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><WrapPanel><ComboBox x:Name="HostBox" Width="260" DisplayMemberPath="Name"/><DatePicker x:Name="StayDate" Width="150" Margin="8,0"/><ComboBox x:Name="AvailabilityBox" Width="140"><ComboBoxItem Content="available"/><ComboBoxItem Content="unknown"/><ComboBoxItem Content="blocked"/></ComboBox><TextBox x:Name="PriceBox" Width="100" Margin="8,0" ToolTip="Preis EUR"/><Button Content="Speichern" Click="SaveAvailability_Click" Padding="12,6"/></WrapPanel><DataGrid Grid.Row="1" x:Name="AvailabilityGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
<TabItem Header="Gepäck"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Button Content="Gepäckketten aller offenen Reisen aktualisieren" Click="RebuildLuggage_Click" HorizontalAlignment="Left" Padding="12,7"/><DataGrid Grid.Row="1" x:Name="LuggageGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
<TabItem Header="Kandidaten &amp; Lücken"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Priorität: Orte mit fehlenden freigegebenen 1-Nacht-Gastgebern zuerst bearbeiten." FontWeight="SemiBold"/><DataGrid Grid.Row="1" x:Name="PriorityGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
</TabControl></Grid></Window>