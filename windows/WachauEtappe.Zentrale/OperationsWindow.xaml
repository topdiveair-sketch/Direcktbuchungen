<Window x:Class="WachauEtappe.Zentrale.OperationsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Betrieb" Height="860" Width="1280" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><TabControl>
<TabItem Header="Verfügbarkeit"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><WrapPanel><ComboBox x:Name="HostBox" Width="250" DisplayMemberPath="Name"/><TextBlock Text="Von" VerticalAlignment="Center" Margin="10,0,4,0"/><DatePicker x:Name="StayDate" Width="135"/><TextBlock Text="Bis" VerticalAlignment="Center" Margin="10,0,4,0"/><DatePicker x:Name="EndDate" Width="135"/><ComboBox x:Name="AvailabilityBox" Width="125" Margin="8,0,0,0"><ComboBoxItem Content="available"/><ComboBoxItem Content="unknown"/><ComboBoxItem Content="blocked"/></ComboBox><TextBox x:Name="PriceBox" Width="90" Margin="8,0" ToolTip="Preis EUR"/><Button Content="Zeitraum speichern" Click="SaveAvailability_Click" Padding="12,6"/></WrapPanel><TextBlock x:Name="AvailabilityStatusText" Foreground="#397356" Margin="0,8,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="AvailabilityGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
<TabItem Header="Online-Partner"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><StackPanel><TextBlock Text="Zentrale Übersicht der von Partnerbetrieben online gemeldeten Zimmerkontingente." FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><TextBox x:Name="PartnerApiBox" Width="330" Text="https://web-production-907d68.up.railway.app" ToolTip="WachauEtappe API"/><PasswordBox x:Name="PartnerAdminPassword" Width="220" Margin="8,0" ToolTip="Admin-Passwort (wird nicht gespeichert)"/><Button Content="Partnerdaten laden" Click="LoadOnlinePartners_Click" Padding="12,6"/></WrapPanel><TextBlock x:Name="PartnerOnlineStatus" Foreground="#397356" Margin="0,8,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="PartnerOnlineGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
<TabItem Header="Tagesdisposition"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/></Grid.RowDefinitions><StackPanel><WrapPanel><TextBlock Text="Tag" VerticalAlignment="Center" Margin="0,0,6,0"/><DatePicker x:Name="DispatchDate" Width="145" SelectedDateChanged="DispatchDate_SelectedDateChanged"/><Button Content="Neu berechnen" Click="OptimizeDispatch_Click" Padding="14,7" Margin="8,0,0,0"/><TextBlock Text="Start &amp; Ende: Aggsbach Markt" FontWeight="Bold" Foreground="#173D32" VerticalAlignment="Center" Margin="18,0,0,0"/></WrapPanel><Border Background="#FFF7E4" CornerRadius="7" Padding="10" Margin="0,10,0,0"><TextBlock Text="Gepäckregel: bis 08:00 Uhr beim Gastgeber fertig beschriftet und abholbereit. Startpreis 25 € je Gepäckstück und Transporttag. Internes Tagesziel für eine volle Runde: mindestens 125 € Umsatz. Zustellung erfolgt im Laufe des Tages; ein Gepäckstück kann dafür die gesamte Rundfahrt mitfahren." TextWrapping="Wrap"/></Border><TextBlock x:Name="DispatchSummary" Margin="0,8,0,0" Foreground="#397356" TextWrapping="Wrap"/></StackPanel><GroupBox Grid.Row="1" Header="Gebuchte Gäste – geplanter Tages-/Unterkunftsort" Margin="0,14,0,10"><DataGrid x:Name="GuestPositionGrid" AutoGenerateColumns="True" IsReadOnly="True"/></GroupBox><TextBlock Grid.Row="2" Text="Optimierte Gepäckroute: Abholung muss immer vor Zustellung erfolgen; anschließend Rückkehr nach Aggsbach Markt." FontWeight="SemiBold" Foreground="#173D32"/><DataGrid Grid.Row="3" x:Name="OptimizedLuggageGrid" Margin="0,10,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
<TabItem Header="Gepäck"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><Button Content="Gepäckketten aller offenen Reisen aktualisieren" Click="RebuildLuggage_Click" HorizontalAlignment="Left" Padding="12,7"/><TextBlock Text="Standard: 25 € je Gepäckstück/Transporttag · Bereitstellung bis 08:00 Uhr · Zustellung im Laufe des Tages." Foreground="#64736D" Margin="0,8,0,0"/></StackPanel><DataGrid Grid.Row="1" x:Name="LuggageGrid" Margin="0,14,0,14" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single" SelectionChanged="LuggageGrid_SelectionChanged"/><Border Grid.Row="2" Background="#F4F1E8" CornerRadius="8" Padding="12"><StackPanel><WrapPanel><TextBox x:Name="ProviderBox" Width="220" ToolTip="Transportpartner / Fahrer" Margin="0,0,8,0"/><ComboBox x:Name="LuggageStatusBox" Width="140" Margin="0,0,8,0"><ComboBoxItem Content="requested"/><ComboBoxItem Content="assigned"/><ComboBoxItem Content="picked_up"/><ComboBoxItem Content="delivered"/><ComboBoxItem Content="cancelled"/></ComboBox><TextBox x:Name="LuggageNoteBox" Width="320" ToolTip="Notiz" Margin="0,0,8,0"/><Button Content="Transport speichern" Click="SaveLuggage_Click" Padding="12,6"/></WrapPanel><TextBlock x:Name="LuggageStatusText" Foreground="#397356" Margin="0,8,0,0"/></StackPanel></Border></Grid></TabItem>
<TabItem Header="Kandidaten &amp; Lücken"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="Priorität: Orte mit fehlenden freigegebenen 1-Nacht-Gastgebern zuerst bearbeiten." FontWeight="SemiBold"/><DataGrid Grid.Row="1" x:Name="PriorityGrid" Margin="0,14,0,0" AutoGenerateColumns="True" IsReadOnly="True"/></Grid></TabItem>
</TabControl></Grid></Window>