<Window x:Class="WachauEtappe.Zentrale.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WachauEtappe Zentrale" Height="820" Width="1320" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#F4F1E8">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#173D32">
            <DockPanel Margin="20">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WACHAUETAPPE" Foreground="White" FontSize="22" FontWeight="Bold" Margin="4,8,0,2"/>
                    <TextBlock Text="Zentrale · Saison 2027" Foreground="#CFE0D9" FontSize="13" Margin="4,0,0,28"/>
                    <Button Content="Dashboard" Tag="Dashboard" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Reisen" Tag="Reisen" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Gastgeber" Tag="Gastgeber" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Verfügbarkeit" Tag="Verfügbarkeit" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Routenplaner" Tag="Routenplaner" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Gepäck" Tag="Gepäck" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Stornos" Tag="Stornos" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                    <Button Content="Kandidaten" Tag="Kandidaten" Click="Navigate_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Separator Margin="0,15" Background="#527267"/>
                    <TextBlock Text="Betreiber-Modus" Foreground="#CFE0D9" FontSize="12"/>
                    <TextBlock Text="Volle Kontrolle" Foreground="White" FontWeight="SemiBold"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="34,28,34,40">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="PageTitle" Text="Dashboard" FontSize="31" FontWeight="Bold" Foreground="#173D32"/>
                        <TextBlock Text="WachauEtappe · Deine Route. Dein Gastgeber." FontSize="14" Foreground="#64736D" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Background="White" CornerRadius="10" Padding="14,9" HorizontalAlignment="Right">
                        <TextBlock Text="● System bereit" Foreground="#397356" FontWeight="SemiBold"/>
                    </Border>
                </DockPanel>

                <UniformGrid Columns="4" Margin="0,28,0,22">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="OFFENE REISEN" Style="{StaticResource CardLabel}"/><TextBlock Text="0" Style="{StaticResource CardValue}"/><TextBlock Text="Noch keine 2027-Anfragen" Style="{StaticResource CardHint}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="4,0,8,0"><StackPanel><TextBlock Text="VERIFIZIERTE GASTGEBER" Style="{StaticResource CardLabel}"/><TextBlock Text="1" Style="{StaticResource CardValue}"/><TextBlock Text="Pilotbetrieb aktiv" Style="{StaticResource CardHint}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="8,0,4,0"><StackPanel><TextBlock Text="GEPÄCK HEUTE" Style="{StaticResource CardLabel}"/><TextBlock Text="0" Style="{StaticResource CardValue}"/><TextBlock Text="Keine Übergaben" Style="{StaticResource CardHint}"/></StackPanel></Border>
                    <Border Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="VERSORGUNGSLÜCKEN" Style="{StaticResource CardLabel}"/><TextBlock Text="5" Style="{StaticResource CardValue}"/><TextBlock Text="Welterbesteig-Pilot" Style="{StaticResource CardHint}"/></StackPanel></Border>
                </UniformGrid>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="Betriebsübersicht" FontSize="20" FontWeight="SemiBold" Foreground="#173D32"/>
                            <TextBlock Text="Was als Nächstes Aufmerksamkeit braucht" Foreground="#718079" Margin="0,4,0,18"/>
                            <Border Background="#FFF7E4" CornerRadius="8" Padding="14" Margin="0,0,0,10"><TextBlock Text="⚑  Gastgebernetz: Dürnstein, Spitz, Mühldorf, Aggsbach Dorf und Mautern weiter ausbauen." TextWrapping="Wrap"/></Border>
                            <Border Background="#EDF5F1" CornerRadius="8" Padding="14" Margin="0,0,0,10"><TextBlock Text="✓  Zuhause am Bach – Wachau ist als Pilot- und Referenzbetrieb hinterlegt." TextWrapping="Wrap"/></Border>
                            <Border Background="#EEF1F5" CornerRadius="8" Padding="14"><TextBlock Text="→  Nächster Systemschritt: lokale Datenbank und Import der vorhandenen Gastgeber-, Routen- und Kandidatendaten." TextWrapping="Wrap"/></Border>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Grundprinzipien" FontSize="20" FontWeight="SemiBold" Foreground="#173D32"/>
                            <TextBlock Text="✓ Direktvertrag Gast ↔ Gastgeber" Margin="0,18,0,8"/>
                            <TextBlock Text="✓ Barzahlung beim Gastgeber" Margin="0,0,0,8"/>
                            <TextBlock Text="✓ Eine Nacht muss möglich sein" Margin="0,0,0,8"/>
                            <TextBlock Text="✓ Gepäckweitergabe organisierbar" Margin="0,0,0,8"/>
                            <TextBlock Text="✓ Keine gekauften Rankings" Margin="0,0,0,8"/>
                            <TextBlock Text="✓ Betreiber entscheidet Freigaben"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="14,11"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="14"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#285548"/></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
        <Style x:Key="CardLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#718079"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="CardValue" TargetType="TextBlock"><Setter Property="Foreground" Value="#173D32"/><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,6,0,2"/></Style>
        <Style x:Key="CardHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#7B8782"/><Setter Property="FontSize" Value="12"/></Style>
    </Window.Resources>
</Window>
