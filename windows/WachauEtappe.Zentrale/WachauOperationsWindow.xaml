<Window x:Class="WachauEtappe.Zentrale.WachauOperationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WachauEtappe · Live Operations" Height="900" Width="1400"
        MinHeight="760" MinWidth="1160" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,12,12"/></Style>
    <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#718079"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style x:Key="Value" TargetType="TextBlock"><Setter Property="Foreground" Value="#173D32"/><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
    <Style x:Key="Primary" TargetType="Button"><Setter Property="Background" Value="#173D32"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/></Style>
  </Window.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <DockPanel>
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="Live Operations" FontSize="30" FontWeight="Bold" Foreground="#173D32"/>
        <TextBlock Text="Die operative WachauEtappe-Zentrale: heute fällige Arbeit, Reisen, Gäste, Partner und Wachstum." Foreground="#64736D" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <ComboBox x:Name="DaysBox" Width="120" SelectedIndex="1" Margin="0,0,8,0"><ComboBoxItem Content="7 Tage"/><ComboBoxItem Content="30 Tage"/><ComboBoxItem Content="90 Tage"/></ComboBox>
        <Button Content="Aktualisieren" Click="Refresh_Click" Style="{StaticResource Primary}"/>
      </StackPanel>
    </DockPanel>

    <UniformGrid Grid.Row="1" Columns="6" Margin="0,24,0,8">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OFFEN > 12H" Style="{StaticResource Label}"/><TextBlock x:Name="DueValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ERSATZBEDARF" Style="{StaticResource Label}"/><TextBlock x:Name="ReplacementValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="NEUE PARTNER-LEADS" Style="{StaticResource Label}"/><TextBlock x:Name="PartnerLeadsValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="HEUTE BESTÄTIGT" Style="{StaticResource Label}"/><TextBlock x:Name="TodayStaysValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="BUCHUNGSWERT" Style="{StaticResource Label}"/><TextBlock x:Name="BookingValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="ERW. PROVISION*" Style="{StaticResource Label}"/><TextBlock x:Name="CommissionValue" Text="—" Style="{StaticResource Value}"/></StackPanel></Border>
    </UniformGrid>

    <TabControl Grid.Row="2" Margin="0,8,0,0">
      <TabItem Header="Heute">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Background="#FFF7E4" CornerRadius="9" Padding="14" Margin="0,0,0,12"><TextBlock x:Name="TodaySummaryText" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#173D32"/></Border>
          <DataGrid Grid.Row="1" x:Name="TodayGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
      </TabItem>

      <TabItem Header="Gästeanfragen">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="BookingSummaryText" VerticalAlignment="Center" Foreground="#397356" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="Bestätigen" Click="ConfirmBooking_Click" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
              <Button Content="Ablehnen" Click="DeclineBooking_Click" Padding="14,8"/>
            </StackPanel>
          </DockPanel>
          <DataGrid Grid.Row="1" x:Name="BookingsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"/>
        </Grid>
      </TabItem>

      <TabItem Header="Reisen">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock x:Name="TripSummaryText" Foreground="#397356" FontWeight="SemiBold" Margin="0,0,0,10"/>
          <DataGrid Grid.Row="1" x:Name="TripsGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
      </TabItem>

      <TabItem Header="Partner &amp; freie Zimmer">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <WrapPanel Margin="0,0,0,10">
            <TextBlock Text="Datum" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <DatePicker x:Name="PartnerDate" Width="145" SelectedDateChanged="PartnerDate_SelectedDateChanged"/>
            <TextBlock x:Name="PartnerSummaryText" VerticalAlignment="Center" Foreground="#397356" FontWeight="SemiBold" Margin="16,0,0,0"/>
          </WrapPanel>
          <DataGrid Grid.Row="1" x:Name="PartnersGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
      </TabItem>

      <TabItem Header="Ersatzunterkünfte">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Absagen mit Zahl der aktuell gemeldeten freien Alternativen am selben Ort und Datum." Foreground="#64736D" Margin="0,0,0,10"/>
          <DataGrid Grid.Row="1" x:Name="ReplacementGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
      </TabItem>

      <TabItem Header="Partner-Leads">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,10">
            <TextBlock x:Name="LeadSummaryText" VerticalAlignment="Center" Foreground="#397356" FontWeight="SemiBold"/>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
              <ComboBox x:Name="LeadStatusBox" Width="140" SelectedIndex="1" Margin="0,0,8,0"><ComboBoxItem Content="new"/><ComboBoxItem Content="contacted"/><ComboBoxItem Content="qualified"/><ComboBoxItem Content="won"/><ComboBoxItem Content="lost"/></ComboBox>
              <Button Content="Status speichern" Click="SaveLeadStatus_Click" Style="{StaticResource Primary}"/>
            </StackPanel>
          </DockPanel>
          <DataGrid Grid.Row="1" x:Name="LeadsGrid" AutoGenerateColumns="True" IsReadOnly="True" SelectionMode="Single"/>
        </Grid>
      </TabItem>

      <TabItem Header="Conversion">
        <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Datensparsame Funnel-Kennzahlen ohne Gastnamen, E-Mail oder Telefonnummer." Foreground="#64736D" Margin="0,0,0,10"/>
          <DataGrid Grid.Row="1" x:Name="FunnelGrid" AutoGenerateColumns="True" IsReadOnly="True"/>
        </Grid>
      </TabItem>

      <TabItem Header="Status">
        <StackPanel Margin="18">
          <TextBlock Text="Online-Verbindung" FontSize="20" FontWeight="SemiBold" Foreground="#173D32"/>
          <TextBlock x:Name="StatusText" Text="Noch nicht geladen." TextWrapping="Wrap" Margin="0,12,0,0"/>
          <TextBlock Text="* Die angezeigte Provision ist nur ein rechnerischer Wert auf Basis bestätigter, bekannter Unterkunftspreise. Es wird dadurch keine Rechnung erstellt oder Zahlung ausgelöst." TextWrapping="Wrap" Foreground="#718079" Margin="0,22,0,0"/>
        </StackPanel>
      </TabItem>
    </TabControl>
  </Grid>
</Window>