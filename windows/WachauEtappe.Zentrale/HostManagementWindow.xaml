<Window x:Class="WachauEtappe.Zentrale.HostManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Gastgeberverwaltung" Height="760" Width="1180" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><TextBlock Text="Gastgeber" FontSize="28" FontWeight="Bold" Foreground="#173D32"/><TextBlock Text="Suchen, prüfen und freigeben" Foreground="#64736D" Margin="0,4,0,16"/><TextBox x:Name="SearchBox" Height="38" Padding="10" TextChanged="SearchBox_TextChanged"/><ListBox x:Name="HostList" Margin="0,12,0,0" DisplayMemberPath="Name" SelectionChanged="HostList_SelectionChanged" Height="590"/></StackPanel>
<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24"><StackPanel><TextBlock Text="Betriebsprüfung" FontSize="23" FontWeight="SemiBold" Foreground="#173D32"/><TextBlock x:Name="HostIdText" Foreground="#7B8782" Margin="0,3,0,18"/>
<TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Ort"/><TextBox x:Name="LocationBox" Margin="0,4,0,10" Padding="8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="E-Mail"/><TextBox x:Name="EmailBox" Margin="0,4,0,10" Padding="8"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Margin="0,4,0,10" Padding="8"/></StackPanel></Grid>
<TextBlock Text="Direktbuchungs-/Kontakt-URL"/><TextBox x:Name="UrlBox" Margin="0,4,0,16" Padding="8"/>
<TextBlock Text="Pflichtprüfung für WachauEtappe" FontWeight="SemiBold" Foreground="#173D32" Margin="0,4,0,8"/>
<CheckBox x:Name="OneNightCheck" Content="1-Nacht-Aufenthalt bestätigt" Margin="0,5"/><CheckBox x:Name="CashCheck" Content="Barzahlung beim Gastgeber bestätigt" Margin="0,5"/><CheckBox x:Name="LuggageCheck" Content="Gepäcktransport organisiert / zuverlässig vermittelbar" Margin="0,5"/><CheckBox x:Name="AcceptingCheck" Content="Nimmt aktuell Buchungsanfragen an" Margin="0,5"/>
<Border Background="#FFF7E4" CornerRadius="7" Padding="12" Margin="0,12"><TextBlock Text="Freigabe ist nur vorgesehen, wenn alle drei WachauEtappe-Pflichtkriterien persönlich geprüft wurden." TextWrapping="Wrap"/></Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Speichern" Click="Save_Click" Padding="18,9" Margin="5"/><Button Content="Freigeben" Click="Publish_Click" Padding="18,9" Margin="5" Background="#397356" Foreground="White"/><Button Content="Sperren" Click="Unpublish_Click" Padding="18,9" Margin="5"/></StackPanel><TextBlock x:Name="StatusText" Foreground="#397356" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
</Grid></Window>