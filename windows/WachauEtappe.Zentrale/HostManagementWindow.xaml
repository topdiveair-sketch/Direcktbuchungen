<Window x:Class="WachauEtappe.Zentrale.HostManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Gastgeberverwaltung" Height="900" Width="1240" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><TextBlock Text="Gastgeber" FontSize="28" FontWeight="Bold" Foreground="#173D32"/><TextBlock Text="Suchen, prüfen und freigeben" Foreground="#64736D" Margin="0,4,0,16"/><TextBox x:Name="SearchBox" Height="38" Padding="10" TextChanged="SearchBox_TextChanged"/><ListBox x:Name="HostList" Margin="0,12,0,0" DisplayMemberPath="Name" SelectionChanged="HostList_SelectionChanged" Height="720"/></StackPanel>
<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Betriebsprüfung" FontSize="23" FontWeight="SemiBold" Foreground="#173D32"/><TextBlock x:Name="HostIdText" Foreground="#7B8782" Margin="0,3,0,18"/>
<TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Ort"/><TextBox x:Name="LocationBox" Margin="0,4,0,10" Padding="8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="105"/><ColumnDefinition Width="105"/></Grid.ColumnDefinitions><StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="E-Mail"/><TextBox x:Name="EmailBox" Margin="0,4,0,10" Padding="8"/></StackPanel><StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Margin="0,4,0,10" Padding="8"/></StackPanel><StackPanel Grid.Column="2" Margin="8,0"><TextBlock Text="Zimmer"/><TextBox x:Name="CapacityBox" Text="1" Margin="0,4,0,10" Padding="8"/></StackPanel><StackPanel Grid.Column="3" Margin="8,0,0,0"><TextBlock Text="Betten"/><TextBox x:Name="BedsBox" Text="2" Margin="0,4,0,10" Padding="8"/></StackPanel></Grid>
<TextBlock Text="Direktbuchungs-/Kontakt-URL"/><TextBox x:Name="UrlBox" Margin="0,4,0,16" Padding="8"/>
<TextBlock Text="Pflichtprüfung für WachauEtappe" FontWeight="SemiBold" Foreground="#173D32" Margin="0,4,0,8"/>
<CheckBox x:Name="OneNightCheck" Content="1-Nacht-Aufenthalt bestätigt" Margin="0,5"/><CheckBox x:Name="CashCheck" Content="Barzahlung beim Gastgeber bestätigt" Margin="0,5"/><CheckBox x:Name="LuggageCheck" Content="Gepäcktransport organisiert / zuverlässig vermittelbar" Margin="0,5"/><CheckBox x:Name="AcceptingCheck" Content="Nimmt aktuell Buchungsanfragen an" Margin="0,5"/>
<Border Background="#FFF7E4" CornerRadius="7" Padding="12" Margin="0,12"><TextBlock Text="Freigabe ist nur vorgesehen, wenn alle drei WachauEtappe-Pflichtkriterien persönlich geprüft wurden. Zimmer und Betten werden für die automatische Belegungsanzeige in der Wanderkarte verwendet." TextWrapping="Wrap"/></Border>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Speichern" Click="Save_Click" Padding="18,9" Margin="5"/><Button Content="Freigeben" Click="Publish_Click" Padding="18,9" Margin="5" Background="#397356" Foreground="White"/><Button Content="Sperren" Click="Unpublish_Click" Padding="18,9" Margin="5"/></StackPanel><TextBlock x:Name="StatusText" Foreground="#397356" Margin="0,14,0,0" TextWrapping="Wrap"/>

<Separator Margin="0,22,0,18"/>
<TextBlock Text="Partnerzugang" FontSize="22" FontWeight="SemiBold" Foreground="#173D32"/>
<TextBlock Text="Der Gastgeber meldet sich ausschließlich mit Betriebs-ID und Passwort an. E-Mail oder zusätzlicher Partner-Code sind für den Login nicht nötig." Foreground="#64736D" TextWrapping="Wrap" Margin="0,4,0,12"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Margin="0,0,8,0"><TextBlock Text="Partner-Passwort"/><TextBox x:Name="PartnerCodeBox" Margin="0,4,0,10" Padding="8" FontFamily="Consolas"/></StackPanel>
<StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Betriebs-ID"/><TextBox x:Name="PartnerHostIdBox" Margin="0,4,0,10" Padding="8" IsReadOnly="True" Background="#F3F5F3"/></StackPanel></Grid>
<WrapPanel Margin="0,4,0,8"><Button Content="Passwort erzeugen" Click="GeneratePartnerCode_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Online-Zugang erstellen / aktualisieren" Click="ProvisionPartner_Click" Padding="14,8" Margin="0,0,8,8" Background="#173D32" Foreground="White"/><Button Content="Online-Zugang sperren" Click="DisablePartner_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Online-Status prüfen" Click="CheckPartnerStatus_Click" Padding="14,8" Margin="0,0,8,8"/><Button Content="Portal-Link kopieren" Click="CopyPortalLink_Click" Padding="14,8" Margin="0,0,8,8"/></WrapPanel>
<Border Background="#EEF5F1" CornerRadius="7" Padding="12" Margin="0,4,0,12"><StackPanel><TextBlock x:Name="PartnerStatusText" Text="Noch nicht geprüft." TextWrapping="Wrap"/><TextBlock Text="Portal: https://topdiveair-sketch.github.io/Direcktbuchungen/partner/" Foreground="#64736D" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></Border>

<TextBlock Text="Online-Verwaltung" FontSize="18" FontWeight="SemiBold" Foreground="#173D32" Margin="0,4,0,6"/>
<TextBlock Text="Das Railway-Adminpasswort wird einmalig auf diesem Windows-Benutzer verschlüsselt gespeichert und danach automatisch verwendet." Foreground="#64736D" TextWrapping="Wrap" Margin="0,0,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><PasswordBox x:Name="AdminPasswordBox" Grid.Column="0" Padding="8" Margin="0,0,8,0"/><Button Grid.Column="1" Content="Speichern &amp; testen" Click="SaveAdminPassword_Click" Padding="14,8" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Löschen" Click="ClearAdminPassword_Click" Padding="14,8"/></Grid>
<TextBlock x:Name="AdminPasswordStatusText" Text="Admin-Zugang noch nicht eingerichtet." Foreground="#64736D" Margin="0,8,0,0" TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></Border>
</Grid></Window>