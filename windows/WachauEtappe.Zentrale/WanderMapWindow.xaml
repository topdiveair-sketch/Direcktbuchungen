<Window x:Class="WachauEtappe.Zentrale.WanderMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WachauEtappe · OpenStreetMap Wanderkarte" Height="900" Width="1450" MinHeight="720" MinWidth="1150"
        WindowStartupLocation="CenterOwner" Background="#F4F1E8">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="OpenStreetMap Wanderkarte &amp; Gastgeberbelegung" FontSize="28" FontWeight="Bold" Foreground="#173D32"/>
                <TextBlock Text="Welterbesteig Wachau · exakter OSM-Wegverlauf (Relation 1309244) · ohne Edge/WebView" Foreground="#64736D" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Datum" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="StayDatePicker" Width="150" SelectedDateChanged="StayDatePicker_SelectedDateChanged"/>
                <Button Content="Karte aktualisieren" Click="Refresh_Click" Padding="14,8" Margin="10,0,0,0"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="8">
                <Grid>
                    <Border Background="#E9EEE9" CornerRadius="8" ClipToBounds="True">
                        <Viewbox Stretch="Uniform">
                            <Canvas x:Name="MapCanvas" Width="920" Height="650" Background="#E9EEE9" MouseLeftButtonDown="MapCanvas_MouseLeftButtonDown"/>
                        </Viewbox>
                    </Border>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="14" Background="#F2FFFFFF" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="●" Foreground="#248A3D" FontSize="18"/><TextBlock Text=" frei" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="●" Foreground="#D68616" FontSize="18"/><TextBlock Text=" wenig frei" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="●" Foreground="#C93030" FontSize="18"/><TextBlock Text=" besetzt" Margin="2,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Text="●" Foreground="#7A8580" FontSize="18"/><TextBlock Text=" nicht gemeldet / Konditionen offen" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="━━" Foreground="#C62828" FontWeight="Bold"/><TextBlock Text=" Welterbesteig (OSM)" Margin="4,0,14,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14" Background="#F2FFFFFF" CornerRadius="8" Padding="10">
                        <StackPanel>
                            <TextBlock x:Name="MapStatusText" Text="OpenStreetMap wird geladen …" Foreground="#475650" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="© OpenStreetMap-Mitwirkende · ODbL · Gastgebermarker anklicken für Details" Foreground="#64736D" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Unterkünfte" FontSize="20" FontWeight="SemiBold" Foreground="#173D32"/>
                        <TextBlock x:Name="SummaryText" Foreground="#64736D" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <Border x:Name="SelectedHostPanel" Background="#EEF5F1" CornerRadius="8" Padding="10" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="SelectedHostText" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <DataGrid x:Name="HostGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionChanged="HostGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="30"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="●" FontSize="20" HorizontalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7A8580"/><Style.Triggers><DataTrigger Binding="{Binding StatusColor}" Value="green"><Setter Property="Foreground" Value="#248A3D"/></DataTrigger><DataTrigger Binding="{Binding StatusColor}" Value="orange"><Setter Property="Foreground" Value="#D68616"/></DataTrigger><DataTrigger Binding="{Binding StatusColor}" Value="red"><Setter Property="Foreground" Value="#C93030"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="Gastgeber" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Ort" Binding="{Binding Location}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding DisplayStatus}" Width="155"/>
                            <DataGridTextColumn Header="Zimmer" Binding="{Binding RoomsFree}" Width="55"/>
                            <DataGridTextColumn Header="Betten" Binding="{Binding BedsFree}" Width="55"/>
                            <DataGridTextColumn Header="Telefon" Binding="{Binding Phone}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="Bestätigte Partner mit noch offenen Konditionen werden grau angezeigt; Zimmer/Betten bleiben bis zur Kapazitätsbestätigung 0." Foreground="#64736D" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button DockPanel.Dock="Right" Content="Telefon kopieren" Click="CopyPhone_Click" Padding="12,7" Margin="10,0,0,0"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>