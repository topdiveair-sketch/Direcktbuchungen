<Window x:Class="WachauEtappe.Zentrale.CandidateManagementWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WachauEtappe · Kandidaten" Height="780" Width="1180" WindowStartupLocation="CenterOwner" Background="#F4F1E8">
<Grid Margin="24"><Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0"><TextBlock Text="Partnerkandidaten" FontSize="28" FontWeight="Bold" Foreground="#173D32"/><TextBlock Text="Nach Versorgungslücke und Eignung priorisieren" Foreground="#64736D" Margin="0,4,0,16"/><TextBox x:Name="SearchBox" Height="38" Padding="10" TextChanged="SearchBox_TextChanged"/><ListBox x:Name="CandidateList" Margin="0,12,0,0" DisplayMemberPath="Name" SelectionChanged="CandidateList_SelectionChanged" Height="610"/></StackPanel>
<Border Grid.Column="2" Background="White" CornerRadius="12" Padding="24"><ScrollViewer><StackPanel><TextBlock Text="Kandidat bearbeiten" FontSize="23" FontWeight="SemiBold" Foreground="#173D32"/><TextBlock x:Name="CandidateIdText" Foreground="#7B8782" Margin="0,3,0,18"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="Name"/><TextBox x:Name="NameBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Ort"/><TextBox x:Name="LocationBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Priorität"/><ComboBox x:Name="PriorityBox" Margin="0,4,0,10"><ComboBoxItem Content="high"/><ComboBoxItem Content="normal"/><ComboBoxItem Content="low"/></ComboBox><TextBlock Text="Fit-Score 0–100"/><TextBox x:Name="FitScoreBox" Margin="0,4,0,10" Padding="8"/></StackPanel>
<StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="Status"/><ComboBox x:Name="StatusBox" Margin="0,4,0,10"><ComboBoxItem Content="research"/><ComboBoxItem Content="contacted"/><ComboBoxItem Content="interested"/><ComboBoxItem Content="qualified"/><ComboBoxItem Content="declined"/></ComboBox><TextBlock Text="E-Mail"/><TextBox x:Name="EmailBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Telefon"/><TextBox x:Name="PhoneBox" Margin="0,4,0,10" Padding="8"/><TextBlock Text="Website"/><TextBox x:Name="UrlBox" Margin="0,4,0,10" Padding="8"/></StackPanel></Grid>
<TextBlock Text="Notizen"/><TextBox x:Name="NotesBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,4,0,12" Padding="8"/><TextBlock x:Name="LastContactText" Foreground="#718079" Margin="0,0,0,12"/>
<WrapPanel HorizontalAlignment="Right"><Button Content="Speichern" Click="Save_Click" Padding="16,8" Margin="0,0,8,0"/><Button Content="Kontakt erfolgt" Click="Contacted_Click" Padding="16,8" Background="#397356" Foreground="White"/></WrapPanel><TextBlock x:Name="StatusText" Foreground="#397356" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Border>
</Grid></Window>